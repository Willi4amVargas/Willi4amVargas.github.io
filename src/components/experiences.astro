---
import { getCollection } from "astro:content";

const experiences = await getCollection("experiences");
---

<div
  class="min-h-screen max-w-5xl mx-auto py-20 px-6 lg:px-8"
  id="experiences"
>
  <h1 class="text-4xl md:text-5xl font-bold text-white mb-16 text-center">Work Experience</h1>
  <div class="space-y-12">
    {
      experiences.map((exp) => {
        return (
          <div class="group relative grid grid-cols-1 md:grid-cols-12 gap-8 p-8 rounded-3xl bg-white/5 border border-white/10 hover:bg-white/10 transition-all duration-500 hover:scale-[1.01] hover:shadow-2xl hover:shadow-white/5">
            {/* DATE */}
            <div class="md:col-span-3 text-slate-400 font-medium pt-1">
              {exp.data.date ? exp.data.date : "Project"}
            </div>

            {/* CONTENT */}
            <div class="md:col-span-9">
              <a
                href={`/experiences/${exp.slug}`}
                class="inline-block group-hover:text-blue-400 transition-colors"
              >
                <h2
                  class="text-2xl font-bold text-white mb-4"
                  transition:name={exp.slug + "-title"}
                >
                  {exp.data.title}
                </h2>
              </a>
              
              <p class="text-slate-300 mb-6 leading-relaxed">
                {exp.data.description}
              </p>

              <div class="flex flex-wrap gap-3 mb-6">
                {exp.data.technologies.map((tech) => (
                  <span class="px-3 py-1 bg-white/5 rounded-full text-xs font-medium text-slate-400 border border-white/5">
                    {tech}
                  </span>
                ))}
              </div>

              <div class="flex gap-4">
                {exp.data.technologies_icons &&
                  exp.data.technologies_icons.map((icon) => (
                    <div class="w-8 h-8 bg-white/5 p-1.5 rounded-lg border border-white/10">
                      <img src={icon} class="w-full h-full object-contain" />
                    </div>
                  ))}
              </div>
            </div>
            
            {/* Link Overlay */}
            <a href={`/experiences/${exp.slug}`} class="absolute inset-0 z-0" aria-label={`View ${exp.data.title}`}></a>
          </div>
        );
      })
    }
  </div>
</div>
